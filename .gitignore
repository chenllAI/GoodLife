# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/

# 本地环境变量 —— Token 绝不能进仓库
.env
.env.local
.env.*.local
*.local
!.env.example

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-error.log*
